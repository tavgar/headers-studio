{
  "manifest_version": 3,
  "name": "Headers Studio",
  "short_name": "Headers Studio",
  "version": "1.1.1",
  "description": "Inspect, copy, and override Chrome request and response headers, including Cookie and Set-Cookie.",
  "minimum_chrome_version": "102",
  "permissions": [
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Headers Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
